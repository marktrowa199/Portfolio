# Server-side only. Never prefix these with NEXT_PUBLIC_ and never commit a filled-in .env.local.
# Gmail address that receives contact-form messages.
CONTACT_GMAIL_USER=arthurnielzz@gmail.com
# Google App Password for that account (requires 2-Step Verification).
# https://myaccount.google.com/apppasswords
CONTACT_GMAIL_APP_PASSWORD=

# Optional. Leave unset to use Gmail SMTP. Set these only to send through a different
# provider (or a local SMTP sink during testing).
# CONTACT_SMTP_HOST=smtp.example.com
# CONTACT_SMTP_PORT=587
