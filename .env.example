# Server-side only. Never commit a filled-in .env.local.
#
# Web3Forms access key. Get it from https://web3forms.com after verifying the email
# address that should receive contact-form messages.
#
# Despite the VITE_ prefix this is a Next.js project, not Vite — the prefix is meaningless
# here and is only kept so the variable name in your existing .env keeps working. The value
# is read in app/api/contact/route.ts on the server, so it is never shipped to the browser.
# Unprefixed WEB3FORMS_ACCESS_KEY is also accepted.
VITE_WEB3FORMS_ACCESS_KEY=your_actual_web3forms_access_key
